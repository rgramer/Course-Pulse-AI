kind = "web"
previewPath = "/"
title = "CoursePulse AI"
version = "1.0.0"
id = "artifacts/coursepulse"
router = "path"

[[integratedSkills]]
name = "react-vite"
version = "1.0.0"

[[services]]
name = "web"
paths = [ "/" ]
localPort = 25276

[services.development]
run = "pnpm --filter @workspace/coursepulse run dev"

[services.production]
build = [ "pnpm", "--filter", "@workspace/coursepulse", "run", "build" ]
publicDir = "artifacts/coursepulse/dist/public"
serve = "static"

[[services.production.rewrites]]
from = "/*"
to = "/index.html"

[services.env]
PORT = "25276"
BASE_PATH = "/"
